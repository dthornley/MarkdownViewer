{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Document windows: core APIs, native file dialog, opening external links in the browser, in-app updates.",
  "windows": [
    "doc-*"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "opener:default",
    "log:default",
    "updater:default",
    "process:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "**"
        }
      ]
    }
  ]
}
