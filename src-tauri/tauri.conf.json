{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Markdown Viewer",
  "version": "../package.json",
  "identifier": "com.thornley.markdownviewer",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "node scripts/stage-frontend.js",
    "beforeBuildCommand": "node scripts/stage-frontend.js"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Markdown Viewer",
        "width": 1100,
        "height": 800,
        "minWidth": 480,
        "minHeight": 320,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' mdv: http://mdv.localhost data: blob: https: http:",
        "media-src": "'self' mdv: http://mdv.localhost",
        "font-src": "'self' data:",
        "connect-src": "'self' mdv: http://mdv.localhost ipc: http://ipc.localhost"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "shortDescription": "Markdown viewer",
    "longDescription": "A simple, friendly viewer for Markdown files with GitHub-flavored Markdown, Mermaid diagrams, math and syntax highlighting. Works offline.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkd"
        ],
        "name": "Markdown Document",
        "description": "Markdown document",
        "role": "Viewer",
        "mimeType": "text/markdown"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY0RTNDRkY4RDlEMzY5MzIKUldReWFkUForTS9qWk1EM1NCbVZiL1IxZkJaU0ttK3Jzbm5CckdHMlRGMjJORGNtT3Jhbmx2QWMK",
      "endpoints": [
        "https://github.com/dthornley/MarkdownViewer/releases/latest/download/latest.json"
      ]
    }
  }
}
